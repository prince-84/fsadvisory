<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. FORCE HTTPS
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 2. CONTROL DOMAIN / WWW & SUBDOMAIN REDIRECT (Redirect www & subdomains to apex domain)
    RewriteCond %{HTTP_HOST} ^(www|mail|webmail|cpanel|webdisk|autodiscover|cpcontacts|cpcalendars)\.fsadvisory\.pk$ [NC]
    RewriteRule ^(.*)$ https://fsadvisory.pk/$1 [R=301,L]

    # 3. 301 REDIRECT EXPLICIT /public/ REQUESTS TO CLEAN URL (SEO DUPLICATE PREVENTION)
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^ https://fsadvisory.pk/%1 [R=301,L]

    # 4. ROUTE REQUESTS TO PUBLIC DIRECTORY (FOR CPANEL ROOT SETUP)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# 4. GSC SUBDOMAIN INDEXING SHIELD (NOINDEX HEADER)
<IfModule mod_headers.c>
    SetEnvIfNoCase Host "^(mail|admin|webmail|cpanel|webdisk|autodiscover|cpcontacts|cpcalendars)\." NOINDEX_SUBDOMAIN
    Header set X-Robots-Tag "noindex, nofollow, noarchive" env=NOINDEX_SUBDOMAIN
</IfModule>
